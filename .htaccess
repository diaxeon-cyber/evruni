ErrorDocument 404 /404.html
RewriteEngine On

# Public root uses the restored classic landing page. Logged-in users are redirected by PHP to /index.php.
RewriteRule ^$ public_landing.php [L]

# Creator Tools is a real page; do not redirect it to the legacy guard page.

# Load stable UI enhancements and Film Guard without relying on PHP auto_prepend/user-ini support.
<IfModule mod_substitute.c>
    AddOutputFilterByType SUBSTITUTE text/html
    Substitute "s|</body>|<script src=\"/assets/sidebar-ui.js?v=5\"></script><script src=\"/assets/creator-film-bridge.js?v=2\"></script><script src=\"/assets/creator-film-guard.js?v=2\"></script></body>|ni"
</IfModule>

# Hide PHP extensions
RewriteCond %{THE_REQUEST} \s/+login\.php(?:[?\s]) [NC]
RewriteRule ^login\.php$ /login [R=301,L]

RewriteCond %{THE_REQUEST} \s/+register\.php(?:[?\s]) [NC]
RewriteRule ^register\.php$ /register [R=301,L]

# Pretty URLs
RewriteRule ^login/?$ login.php [L]
RewriteRule ^register/?$ register.php [L]

# Block private files/directories
RewriteRule ^_private(?:/|$) - [F,L,NC]
RewriteRule ^\.env(?:.*)$ - [F,L,NC]
RewriteRule ^\.git(?:/|$) - [F,L,NC]

# Block common sensitive project files
<FilesMatch "^(?:\.env.*|.*\.sql|.*\.bak|README.*|MANIFEST\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Do not execute scripts in generated media
<FilesMatch "\.(php|phtml|phar|cgi|pl)$">
    <If "%{REQUEST_URI} =~ m#^/media/generated/#">
        Order allow,deny
        Deny from all
    </If>
</FilesMatch>
